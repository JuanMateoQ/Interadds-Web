# ───────────────────────────────────────────────────────────────
# Interadds (Web B1) - variables de entorno de EJEMPLO.
# Copia este archivo a ".env" y ajusta los valores. NUNCA subas ".env" al repositorio (RNF-02, RS-11).
# ───────────────────────────────────────────────────────────────

# Servidor
NODE_ENV=development
PORT=3000
# Origen público de la aplicación (se usa para validar Origin en POST y en el handshake de Socket.IO).
APP_ORIGIN=http://localhost:3000
# En producción (HTTPS/wss) pon true: la cookie de sesión se marca Secure.
COOKIE_SECURE=false

# Base de datos PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interadds
# Base SOLO para pruebas: su nombre debe terminar en "_test" (las pruebas la vacían)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interadds_test

# Sesiones y tokens
SESSION_TTL_HOURS=8
RESET_TOKEN_TTL_MINUTES=30
# Costo de bcrypt (RS-12). 12 en producción; las pruebas usan 4.
BCRYPT_ROUNDS=12

# ── Autoridad certificadora de Interadds (RS-10, RS-11, RS-46) ──
# "npm run ca:init" genera la CA raíz (clave fuera de línea) y la CA emisora.
# La CLAVE PRIVADA de la CA emisora se lee de un archivo o de una variable en base64 (nunca del código).
CA_DIR=./ca-data
CA_ROOT_CERT_FILE=./ca-data/root-ca.cert.pem
CA_ISSUING_CERT_FILE=./ca-data/issuing-ca.cert.pem
CA_ISSUING_KEY_FILE=./ca-data/issuing-ca.key.pem
# Alternativa a los archivos: contenido PEM codificado en base64 (útil en hosting sin disco)
CA_ISSUING_KEY_B64=
CA_ISSUING_CERT_B64=
CA_ROOT_CERT_B64=
# La clave de la CA RAÍZ se guarda aquí solo tras "ca:init": muévela a un medio sin conexión.
CA_ROOT_OFFLINE_DIR=./ca-offline

# ── Pagos: PayPal Orders v2, SOLO Sandbox durante el semestre (RNF-24) ──
# paypal = API real de Sandbox | fake = pasarela simulada en memoria (solo desarrollo y pruebas)
PAYMENT_GATEWAY=paypal
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# El mismo Client ID, expuesto al navegador para los botones de PayPal (es público, no es secreto)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_TIMEOUT_MS=10000
PAYPAL_ORDER_TTL_HOURS=3

# ── Entrega de contenido (RF-26) ──
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10

# Contraseña de las cuentas de demostración creadas por "npm run db:seed"
SEED_DEMO_PASSWORD=Demo1234!
